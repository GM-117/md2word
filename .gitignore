# dependencies
node_modules/

# build output
dist/
dist-electron/
out/
build/
*.tsbuildinfo

# pandoc sidecar binary (fetched by packages/core/scripts/fetch-pandoc.mjs, locked by assets/pandoc.lock.json)
packages/core/assets/bin/
packages/core/assets/downloads/
packages/core/assets/pandoc-*.zip

# test & coverage
coverage/
playwright-report/
test-results/
.blob-testing/

# docx 转换产物（不入库，保留内置模板和测试夹具）
*.docx
!packages/core/assets/reference-zh.docx
!packages/core/test/fixtures/*.docx
!packages/web-host/e2e/fixtures/*.docx

# 大样例由 scripts/generate-large-samples.mjs 生成（§5.2），不入库
samples/large-*.md
samples/**/*.docx

# runtime data (settings, logs, caches)
.data/
*.log

# desktop（Electron 壳）构建产物
packages/desktop/resources/
packages/desktop/release/

# electron-builder 资源目录（buildResources）必须入库：图标 + GPL 随包声明是 CI 打包依赖；
# 其余内容仍忽略。曾因通用 build/ 规则整目录被忽略，CI 产物丢图标与 GPL 声明（D40）
!packages/desktop/build/
packages/desktop/build/*
!packages/desktop/build/icon.icns
!packages/desktop/build/icon.ico
!packages/desktop/build/icon_512.png
!packages/desktop/build/THIRD-PARTY-LICENSES.md

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
