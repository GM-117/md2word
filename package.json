{
  "name": "md2word",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "个人跨平台 Markdown→Word 桌面工具（pandoc sidecar 架构，方案 A）",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "pnpm --filter @md2word/core run fetch:pandoc",
    "dev": "concurrently -k -n host,renderer -c blue,green \"pnpm --filter @md2word/web-host dev\" \"pnpm --filter @md2word/renderer dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @md2word/core test:unit",
    "test:integration": "pnpm --filter @md2word/core test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}