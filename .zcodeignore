# dependencies
node_modules/

# build output
dist/
dist-electron/
out/
build/
*.tsbuildinfo

# pandoc sidecar binary (fetched by packages/core/scripts/fetch-pandoc.mjs, locked by assets/pandoc.lock.json)
packages/core/assets/bin/
packages/core/assets/downloads/
packages/core/assets/pandoc-*.zip

# test & coverage
coverage/
playwright-report/
test-results/
.blob-testing/

# docx 转换产物（不入库，保留内置模板和测试夹具）
*.docx
!packages/core/assets/reference-zh.docx
!packages/core/test/fixtures/*.docx
!packages/web-host/e2e/fixtures/*.docx

# 大样例由 scripts/generate-large-samples.mjs 生成（§5.2），不入库
samples/large-*.md
samples/**/*.docx

# runtime data (settings, logs, caches)
.data/
*.log

# desktop（Electron 壳）构建产物
packages/desktop/resources/
packages/desktop/release/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
